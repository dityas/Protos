(start

; Basic attacker MDP domain
(vars
    (HostHasData    (yes no))
    (DataLocated    (yes no))
    (HostHasVuln    (yes no))
    (AttackerPrivs  (none user admin))
    (DataAccessPrivs    (user admin))

; Random variable for attacker actions
    (AttActions     (file_recon exit no_op))
)


; Effect of file recon action
(def dd_file_recon_
(dd AttackerPrivs
    (none (eye ))
)
)

	


(defdd dataLocSData

	(HOST_HAS_DATA'
		(critical
			(DATA_LOCATED'
				(critical 	(0.5))
				(sensitive 	(0.0))
				(none 		(0.25))
				(other 		(0.25))
			)
		)
		
		(sensitive
			(DATA_LOCATED'
				(critical 	(0.0))
				(sensitive 	(0.9))
				(none 		(0.05))
				(other 		(0.05))
			)
		)
		
		(none
			(DATA_LOCATED'
				(critical 	(0.0))
				(sensitive 	(0.0))
				(none 		(0.5))
				(other 		(0.5))
			)
		)
	)
)

(defdd dataLocFRCData

	(ATTACKER_PRIVS
		(user
			(DATA_ACCESS_PRIVS
				(user 	(dataLocCData))
				(admin 	
					(DATA_LOCATED'
						(critical 	(0.0))
						(sensitive 	(0.0))
						(none 		(0.5))
						(other 		(0.5))
					)
				)
			)
		)
		
		(admin
			(DATA_ACCESS_PRIVS
				(user 	(dataLocCData))
				(admin 	(dataLocCData))
			)
		)
		
		(none 	(DATA_LOCATED' none))
	)
)

(defdd dataLocFRSData

	(ATTACKER_PRIVS
		(user
			(DATA_ACCESS_PRIVS
				(user 	(dataLocSData))
				(admin 	
					(DATA_LOCATED'
						(critical 	(0.0))
						(sensitive 	(0.0))
						(none 		(0.5))
						(other 		(0.5))
					)
				)
			)
		)
		
		(admin
			(DATA_ACCESS_PRIVS
				(user 	(dataLocSData))
				(admin 	(dataLocSData))
			)
		)
		
		(none 	(DATA_LOCATED' none))
	)
) 
)
